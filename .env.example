# cocode runs its AI workflows on your machine, with your own provider keys.
#
# It ships with the OpenAI backend switched on, and the model deck's default tiers are OpenAI models,
# so OPENAI_API_KEY is all you need to start. A key on its own is not enough for any other provider:
# its backend also has to be switched on, and the deck's aliases pointed at its models. The README says
# how, and so does https://docs.pipelex.com/latest/get-started/configure-ai-providers/

# OpenAI: the provider cocode ships configured for
OPENAI_API_KEY=

# Azure: to use OpenAI models on Azure cloud
AZURE_API_BASE=
AZURE_API_VERSION=
AZURE_API_KEY=

# AWS Bedrock - To use models via Amazon Bedrock: supports Claude models and many open-source models
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# To use Claude models directly from their creator, Anthropic
ANTHROPIC_API_KEY=

# To use Mistral models
MISTRAL_API_KEY=

# OpenRouter: one key for models from many providers at once
OPENROUTER_API_KEY=

# To generate images from fal.ai
FAL_API_KEY=

# Google AI Studio - Use GOOGLE_API_KEY for direct API access (simpler, rate-limited)
GOOGLE_API_KEY=

# Google Cloud Platform (GCP) - Use these for production Vertex AI access (requires GCP project setup)
# We recommend using GOOGLE_API_KEY OR GCP credentials, not both
GCP_PROJECT_ID=
GCP_LOCATION=
GCP_CREDENTIALS_FILE_PATH=gcp_credentials.json

# To use Grok from x.ai
XAI_API_KEY=

# To get access to many models with one key from blackbox.ai
BLACKBOX_API_KEY=
