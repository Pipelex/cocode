# cocode runs its AI pipelines on your own provider keys. Copy this file to .env and fill in what you use.
# pipelex loads .env over your shell environment, so a variable set here to an empty value hides the
# same variable exported in your shell: leave a line commented out rather than empty.

# OpenAI (required by the shipped configuration): the only backend enabled in .pipelex/inference/backends.toml,
# and every model cocode's pipelines use by default is an OpenAI model. Uncomment the line and set your key,
# unless you export OPENAI_API_KEY in your shell.
# OPENAI_API_KEY=

# Other providers are optional. Each is read only once you enable its backend in
# .pipelex/inference/backends.toml. The active routing profile then routes each model to the first
# enabled backend that serves it, OpenAI first, so no routing change is needed. Every enabled backend
# needs its key: to run on Azure OpenAI instead of OpenAI, disable the openai backend as well. A
# provider that does not serve OpenAI models also needs the default models repointed at models it
# serves, in .pipelex/inference/deck/x_custom_llm_deck.toml.

# Azure OpenAI: the same OpenAI models on Azure, which serve the default models once openai is disabled
# AZURE_API_BASE=
# AZURE_API_VERSION=
# AZURE_API_KEY=

# Anthropic: Claude models directly from Anthropic
# ANTHROPIC_API_KEY=

# Amazon Bedrock: Claude and many open-source models through AWS
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=

# Google AI Studio: Gemini models with a direct API key
# GOOGLE_API_KEY=

# Google Vertex AI: Gemini models through a Google Cloud project (use these or GOOGLE_API_KEY, not both)
# GCP_PROJECT_ID=
# GCP_LOCATION=
# GCP_CREDENTIALS_FILE_PATH=gcp_credentials.json

# Mistral AI: Mistral models and Mistral OCR
# MISTRAL_API_KEY=

# xAI: Grok models
# XAI_API_KEY=

# fal.ai: image generation
# FAL_API_KEY=

# OpenRouter: many providers' models with one key
# OPENROUTER_API_KEY=

# BlackBox AI: many providers' models with one key
# BLACKBOX_API_KEY=

# The backends below read these variables too. Hugging Face, Linkup and TypeSafe also need their
# pipelex extra installed, such as `pip install "pipelex[linkup]"`; pipelex names the extra when one is missing.
# GROQ_API_KEY=
# HF_TOKEN=
# LINKUP_API_KEY=
# MINIMAX_API_KEY=
# PORTKEY_API_KEY=
# SCALEWAY_ENDPOINT=
# SCALEWAY_API_KEY=
# TYPESAFE_API_KEY=
